{
  "manifest_version": 3,
  "name": "ChatGPT Image Auto - CTE",
  "version": "1.0.0",
  "description": "Batch-generate images on ChatGPT from a prompt queue and auto-download the results.",
  "permissions": ["storage", "downloads", "sidePanel", "scripting", "alarms"],
  "host_permissions": ["https://chatgpt.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "ChatGPT Image Auto - CTE",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
